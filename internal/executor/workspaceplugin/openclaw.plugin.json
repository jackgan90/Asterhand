{
  "id": "asterhand-workspace",
  "name": "Asterhand workspace tools",
  "activation": {"onStartup": true},
  "contracts": {
    "tools": [
      "read_file",
      "write_file",
      "edit_file",
      "apply_file_patch",
      "list_dir",
      "search_files",
      "memory_search",
      "memory_get",
      "progress_card"
    ]
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "workspace": {"type": "string"},
      "endpoint": {"type": "string"},
      "token": {"type": "string"},
      "policy": {"type": "string"}
    },
    "required": ["workspace", "endpoint", "token", "policy"],
    "additionalProperties": false
  }
}
